# Copy to k8s/secrets.env and fill in real values before running k8s/deploy.sh.
# k8s/secrets.env is gitignored — never commit it.
#
# Consumed by: kubectl create secret generic platform-secrets --from-env-file=k8s/secrets.env
# (deploy.sh does this for you.)

# ── DB passwords ──────────────────────────────────────────────────────────
AUTH_DB_PASSWORD=kindDevAuth123
USER_DB_PASSWORD=kindDevUser123
ORDER_DB_PASSWORD=kindDevOrder123
PAYMENT_DB_PASSWORD=kindDevPayment123

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=kindDevRedis123

# ── JWT (RS256 key pair itself goes in k8s/secrets/jwt-*.pem, see README) ──
JWT_KEY_ID=local-dev-key-1
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# ── Admin seeding (optional) ────────────────────────────────────────────────
ADMIN_EMAIL=admin@platform.local
ADMIN_PASSWORD=AdminPass123!
ADMIN_USER_ID=999999
ADMIN_NAME=Platform
ADMIN_SURNAME=Admin
ADMIN_BIRTH_DATE=1990-01-01
